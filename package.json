{
  "name": "pi-oneturnagent",
  "version": "0.1.0",
  "description": "One-turn model substitution for Pi Coding Agent: $ swaps the model for a single turn, $$ also trims the session to the agent's final output (pi 0.99.x / @earendil-works)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleqtrizit/pi-oneturnagent.git"
  },
  "author": "Agustin",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "main": "extensions/index.ts",
  "files": [
    "extensions",
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ]
  }
}
